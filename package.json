{
  "name": "@keload/node-red-dxp",
  "version": "2.4.0",
  "description": "CLI and library to build and watch Node-RED node packages (controller, editor, locales, docs).",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm tsc --noEmit",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "format": "pnpm biome format",
    "lint": "pnpm biome lint",
    "lint:check": "pnpm biome check",
    "lint:ci": "pnpm biome ci",
    "release": "pnpm release-it",
    "release:test": "pnpm release-it --dry-run",
    "docs:prepare": "pnpm tsx generate-docs.ts",
    "docs:dev": "pnpm docs:prepare && vitepress dev docs",
    "docs:build": "pnpm docs:prepare && vitepress build docs",
    "docs:preview": "pnpm docs:prepare && vitepress preview docs",
    "test:unit": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "node-red-dxp": "./dist/cli/index.cjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editor": {
      "import": "./dist/editor/index.js",
      "require": "./dist/editor/index.cjs"
    },
    "./editor/dom-helper": {
      "import": "./dist/editor/dom-helper/index.js",
      "require": "./dist/editor/dom-helper/index.cjs"
    },
    "./builder": {
      "import": "./dist/builder/index.js",
      "require": "./dist/builder/index.cjs"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./utils/controller": {
      "import": "./dist/utils/controller.js",
      "require": "./dist/utils/controller.cjs"
    },
    "./editor/svelte": {
      "types": "./dist/editor/svelte/index.d.ts",
      "import": "./dist/editor/svelte/index.js",
      "require": "./dist/editor/svelte/index.cjs"
    },
    "./editor/svelte/Root.svelte": "./dist/editor/svelte/Root.svelte",
    "./ui": {
      "default": "./dist/ui/index.js"
    },
    "./ui/*": "./dist/ui/*",
    "./package.json": "./package.json"
  },
  "keywords": [],
  "author": "Clément BERARD <contact@berard.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clement-berard/node-red-dxp.git"
  },
  "bugs": {
    "url": "https://github.com/clement-berard/node-red-dxp/issues"
  },
  "homepage": "https://github.com/clement-berard/node-red-dxp",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@clack/prompts": "^1.9.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/pug": "^2.0.10",
    "jquery": "^4.0.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^31.0.1",
    "release-it": "21.1.2",
    "svelte2tsx": "^0.7.63",
    "tsdown": "^0.23.7",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "6.0.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-npm-commands": "^0.10.0",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitest": "5.1.0",
    "zod2md": "^0.4.0"
  },
  "dependencies": {
    "@fullhuman/postcss-purgecss": "9.1.0",
    "@tailwindcss/node": "^4",
    "@tailwindcss/oxide": "^4",
    "@types/html-minifier-terser": "7.0.2",
    "@types/jquery": "4.0.1",
    "@types/jqueryui": "1.12.25",
    "@types/node-red": "1.3.5",
    "@types/prettyjson": "0.0.33",
    "browser-sync": "3.0.4",
    "chokidar": "6.0.0",
    "commander": "15.1.0",
    "cosmiconfig": "10.0.1",
    "es-toolkit": "^1.53.2",
    "esbuild": "0.28.2",
    "esbuild-svelte": "^0.9.5",
    "fast-glob": "3.3.3",
    "html-minifier-terser": "7.2.0",
    "mdx-to-md": "0.5.2",
    "nodemon": "3.1.14",
    "package-manager-detector": "^1.9.0",
    "postcss": "8.5.33",
    "prettyjson": "1.2.5",
    "pug": "3.0.4",
    "radash": "12.1.1",
    "sass": "1.108.2",
    "svelte": "^5.58.0",
    "tailwindcss": "^4",
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22"
  }
}
